{
  "name": "online-board",
  "version": "0.1.0",
  "private": true,
  "description": "Онлайн-доска для уроков на базе Excalidraw и Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "web",
    "worker"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mock:ws": "node scripts/mock-ws.mjs",
    "smoke:ws": "node scripts/ws-smoke.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4",
    "ws": "^8.18.0"
  }
}
