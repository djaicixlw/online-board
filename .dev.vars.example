# Локальные переменные и секреты для разработки (wrangler dev)
# Скопируйте этот файл в worker/.dev.vars (или запустите npm run dev — скрипт создаст его автоматически).
# ВНИМАНИЕ: Никогда не коммитьте реальный файл .dev.vars в Git!

# Интервал сохранения снимка доски в SQLite внутри Durable Object (в миллисекундах, по умолчанию 5000 —
# вдвое меньше 10-секундного порога WebSocket Hibernation в Cloudflare)
SAVE_INTERVAL_MS=5000

# Разрешить подключение к любому ID доски без проверки PILOT_BOARD_IDS / D1 (ТОЛЬКО ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ!)
# В продакшене всегда должно быть false.
ALLOW_ANY_BOARD_ID=true

# Пример секрета со списком разрешённых досок на пилоте (при ALLOW_ANY_BOARD_ID=false, до 50 ID base62 через запятую):
# PILOT_BOARD_IDS=0123456789abcdefghijkl,AbCdEfGhIjKlMnOpQrSt12
